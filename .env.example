# Copy to .env and fill in. .env is gitignored — never commit real values.

# APP_PASSWORD is gone — accounts live in Postgres now (see DATABASE_URL)

# Signing key for session cookies. Generate with:  openssl rand -hex 32
# Changing this invalidates every existing session.
SECRET_KEY=change-me

# Postgres holding user accounts. From a container, 172.17.0.1 is the host.
DATABASE_URL=postgresql://user:password@172.17.0.1:5432/gsinotes
